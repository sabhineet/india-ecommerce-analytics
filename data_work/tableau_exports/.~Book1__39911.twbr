    <dashboard enable-sort-zone-taborder='true' name='Regional Performance'>
      <style />
      <size maxheight='800' maxwidth='1200' minheight='800' minwidth='1200' preset-index='8' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='92039' id='11' param='vert' type-v2='layout-flow' w='98666' x='667' y='1000'>
            <zone h='5250' id='12' type-v2='title' w='98666' x='667' y='1000'>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='4' />
              </zone-style>
            </zone>
            <zone h='5000' id='13' type-v2='text' w='98666' x='667' y='6250'>
              <formatted-text>
                <run fontcolor='#000000' fontname='Benton Sans Book'>Madhya Pradesh and Maharashtra bring in 46% of revenue and 47% of profit. Six city rows lose money (about ₹5,800 in total), and Chennai alone lost ₹2,216. Mumbai has the most orders (68) but only a 2.6% margin.</run>
              </formatted-text>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='4' />
              </zone-style>
            </zone>
            <zone h='81789' id='7' param='horz' type-v2='layout-flow' w='98666' x='667' y='11250'>
              <zone h='81789' id='5' type-v2='layout-basic' w='98666' x='667' y='11250'>
                <zone h='81789' id='3' name='State Profit' w='49333' x='667' y='11250'>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                  </zone-style>
                </zone>
                <zone h='81789' id='9' name='City Profit' w='49333' x='50000' y='11250'>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                  </zone-style>
                </zone>
              </zone>
            </zone>
          </zone>
          <zone h='5961' id='14' type-v2='text' w='98666' x='667' y='93039'>
            <formatted-text>
              <run fontcolor='#000000' fontname='Benton Sans Book'>Note: Chandigarh appears under both Punjab and Haryana in the source data (30 orders combined, roughly break-even), so Punjab&apos;s loss and Haryana&apos;s profit should be read with caution. Chennai&apos;s loss (8 orders) is largely driven by a single customer, so treat it as a flag to investigate, not a conclusion.</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
      </zones>
